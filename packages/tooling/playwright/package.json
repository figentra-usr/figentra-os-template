{
  "name": "@figentra/playwright-config",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/figentra-usr/figentra-os-template",
    "directory": "packages/tooling/playwright"
  },
  "files": [
    "*.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./playwright.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "catalog:quality"
  },
  "devDependencies": {
    "@figentra/typescript-config": "workspace:*",
    "@figentra/vitest-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
