{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Figentra",
  "description": "Figentra platform and Academorix — architecture, standards, runbooks and decisions. Navigation is generated by scripts/nav.mjs; edit SECTIONS there, not here.",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/<your-org>/<your-repo>"
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "seo": {
    "indexing": "navigable"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "Start",
            "pages": ["index"]
          },
          {
            "group": "Architecture",
            "pages": ["platform/index"]
          },
          {
            "group": "Standards",
            "pages": ["engineering/standards/index"]
          },
          {
            "group": "Engineering system",
            "pages": ["engineering/system/index"]
          },
          {
            "group": "Engineering",
            "pages": ["engineering/index"]
          },
          {
            "group": "Runbooks",
            "pages": ["runbooks/index"]
          }
        ]
      },
      {
        "tab": "Products",
        "groups": [
          {
            "group": "Products",
            "pages": ["products/index"]
          },
          {
            "group": "Plans",
            "pages": ["plans/index"]
          }
        ]
      },
      {
        "tab": "Company",
        "groups": [
          {
            "group": "Company",
            "pages": ["company/index"]
          },
          {
            "group": "Compliance",
            "pages": ["compliance/index"]
          },
          {
            "group": "Legal",
            "pages": ["legal/index"]
          }
        ]
      },
      {
        "tab": "Decisions",
        "groups": [
          {
            "group": "ADRs",
            "pages": ["adr/index"]
          }
        ]
      },
      {
        "tab": "Legacy",
        "groups": [
          {
            "group": "Superseded",
            "pages": ["legacy/index"]
          }
        ]
      }
    ]
  }
}
