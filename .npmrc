# Repository policy only. No tokens, no registries with credentials — those live in Infisical/Doppler,
# never here (this file is committed). pnpm's own settings (catalogs, build approvals, etc.) live in
# pnpm-workspace.yaml, not here; .npmrc is for npm-registry/auth config only.

# Fail install instead of silently running on a Node/pnpm version outside `engines` (mise.toml pins them).
engine-strict=true
